@{
ViewData["Title"] = "Convertir P12 a PFX";
}

<div class="row justify-content-center">
<div class="col-lg-7">
<div class="d-flex align-items-center gap-3 mb-3">
<span class="icono-arca"><i class="bi bi-arrow-repeat"></i></span>
<div>
<h1 class="h4 mb-0 texto-navy">Convertir .p12 a .pfx</h1>
<div class="text-muted small">Sin contrasena, en los dos casos</div>
</div>
</div>

<div class="card card-arca">
<div class="card-body p-4">
<p class="text-muted small">
Subi un archivo .p12 sin contrasena. Se va a reexportar como .pfx
(mismo formato, PKCS#12) y se descarga automaticamente.
</p>

@if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
{
<div class="alert alert-danger small">
<i class="bi bi-exclamation-triangle me-1"></i>
@ViewData.ModelState[string.Empty]!.Errors[0].ErrorMessage
</div>
}

<form method="post" action="/Certificados/ConvertirP12APfx" enctype="multipart/form-data">
@Html.AntiForgeryToken()

<div class="mb-4">
<label for="archivoP12" class="form-label">Archivo .p12 (sin contrasena)</label>
<input type="file" class="form-control @(ViewData.ModelState["archivoP12"]?.Errors.Count > 0 ? "is-invalid" : "")"
id="archivoP12" name="archivoP12" accept=".p12,.pfx" />
@if (ViewData.ModelState["archivoP12"]?.Errors.Count > 0)
{
<div class="invalid-feedback">@ViewData.ModelState["archivoP12"]!.Errors[0].ErrorMessage</div>
}
</div>

<button type="submit" class="btn btn-arca px-4">
<i class="bi bi-file-earmark-arrow-down me-1"></i> Convertir y descargar .pfx
</button>
<a href="/Certificados" class="btn btn-outline-arca px-4">
<i class="bi bi-arrow-left me-1"></i> Volver
</a>
</form>
</div>
</div>

<div class="alert bg-arca-soft border-0 mt-4 small">
<i class="bi bi-info-circle texto-navy me-1"></i>
<strong>Importante:</strong> .p12 y .pfx son el mismo formato
(PKCS#12); esto solo sirve para cambiar la extension/reencodear el
archivo cuando algun sistema exige puntualmente .pfx. Si el .p12
tiene contrasena, la conversion va a fallar: primero hay que
sacarsela.
</div>
</div>
</div>
