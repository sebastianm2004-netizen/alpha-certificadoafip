<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - Certificados Digitales</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
<style>
:root {
--arca-navy: #242C4F;
--arca-navy-dark: #171d38;
--arca-navy-soft: #eef0f6;
}

html, body {
background: #f5f6f8;
font-family: "Segoe UI", Arial, sans-serif;
}

.navbar-arca {
background: var(--arca-navy);
}

.navbar-arca .navbar-brand {
color: #fff;
font-weight: 700;
letter-spacing: .3px;
}

.navbar-arca .navbar-brand small {
display: block;
font-size: .7rem;
font-weight: 400;
color: #c7cbe0;
}

.card-arca {
border: none;
border-top: 4px solid var(--arca-navy);
border-radius: .75rem;
box-shadow: 0 1px 3px rgba(0,0,0,.08), 0 1px 2px rgba(0,0,0,.06);
}

.btn-arca {
background: var(--arca-navy);
border-color: var(--arca-navy);
color: #fff;
font-weight: 600;
}

.btn-arca:hover,
.btn-arca:focus {
background: var(--arca-navy-dark);
border-color: var(--arca-navy-dark);
color: #fff;
}

.btn-outline-arca {
border-color: var(--arca-navy);
color: var(--arca-navy);
font-weight: 600;
}

.btn-outline-arca:hover {
background: var(--arca-navy);
color: #fff;
}

.form-label {
font-weight: 600;
font-size: .9rem;
}

.form-control:focus {
border-color: var(--arca-navy);
box-shadow: 0 0 0 .2rem rgba(36, 44, 79, .15);
}

.bg-arca-soft {
background: var(--arca-navy-soft);
}

.texto-navy {
color: var(--arca-navy);
}

.icono-arca {
width: 42px;
height: 42px;
border-radius: 50%;
background: var(--arca-navy);
color: #fff;
display: inline-flex;
align-items: center;
justify-content: center;
font-size: 1.2rem;
}
</style>
</head>
<body>
<nav class="navbar navbar-arca navbar-dark">
<div class="container">
<a class="navbar-brand" href="/Certificados">
ARCA <small>Certificado Digital &middot; Factura Electronica</small>
</a>
</div>
</nav>

<div class="container py-4">
@RenderBody()
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
